{
    "version": 1,
    "excludeLodsFromVanillaDepth": true,
    "captureLodShadowCasterDepth": true,
    "opaqueDrawBuffers": [
        4,
        1,
        2,
        3,
        17
    ],
    "translucentDrawBuffers": [
        16,
        17,
        19,
        20
    ],
    "blending": {
        "-1" : "off",
        "0" : "ONE ONE_MINUS_SRC_ALPHA ONE ONE_MINUS_SRC_ALPHA"
    },
    "taaOffset": "{
        #if ANTI_ALIASING == 2
            vec2 jitterOffsets[8] = vec2[8](
                vec2( 0.125, -0.375),
                vec2(-0.125,  0.375),
                vec2( 0.625,  0.125),
                vec2( 0.375, -0.625),
                vec2(-0.625,  0.625),
                vec2(-0.875, -0.125),
                vec2( 0.375, -0.875),
                vec2( 0.875,  0.875)
            );
            return jitterOffsets[frameMod] / vec2(viewWidth, viewHeight);
        #else
            return vec2(0.0);
        #endif
    }",
    "uniforms": [
        "viewWidth",
        "viewHeight",
        "frameMod",
        "frameFract",
        "fragmentFrameTime",
        "vertexFrameTime",
        "dayCycle",
        "twilightPhase",
        "shdFade",
        "fogColor",
        "nightVision",
        "lightningFlash",
        "rainStrength",
        "isPrecipitationRain",
        "isEyeInWater",
        "eyeSkylight",
        "voxyLightDir",
        "cameraPosition",
        "previousCameraPosition",
        "shadowModelView",
        "shadowProjection",

        "gbufferModelView",
        "gbufferModelViewInverse",
        "gbufferProjection",
        "gbufferProjectionInverse",
        "gbufferPreviousModelView",
        "gbufferPreviousProjection",

        "vxRenderDistance",
        "vxModelView",
        "vxModelViewInv",
        "vxModelViewPrev",
        "vxProj",
        "vxProjInv",
        "vxProjPrev"
    ],
    "samplers": {
        "colortex18": "sampler2D",
        "vxDepthTexOpaque": "sampler2D",
        "vxDepthTexTrans": "sampler2D",
        "noisetex": "sampler2D",
        "shadowtex0": "sampler2DShadow",
        "shadowtex1": "sampler2DShadow",
        "shadowcolor0": "sampler2D"
    }
}
